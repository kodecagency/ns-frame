---
// Isla (móvil), hecha con ns-frame/isle: una cápsula y una hoja.
// · La cápsula muestra la sección actual y su posición; al bajar se encoge a un icono. Es un
//   redondeo simple (vía rápida nativa de ns-frame): plegarla no recalcula ninguna forma.
// · Al tocarla, la hoja sube desde abajo (sólo `translate`) y la cápsula se desvanece. La hoja ya
//   tiene su tamaño final y se prepara al apoyar el dedo: al abrirse ya está pintada.
// · La hoja se arrastra como en una app nativa y se cierra al soltarla o lanzarla.
// · En la hoja, la sección actual es la única pieza con chaflán y luz en U.
// · Deslizar la cápsula a los lados salta a la sección anterior o siguiente.
import Icon from '../Icon.astro'
import { SECTIONS, LINKS } from '../../data/sections'
const CUR = 'tl+br bevel 14; tr+bl round 16; radius 2'
---
<nav class="isle" id="isle" aria-label="Secciones" data-ns="all round 27" data-ns-isle data-ns-glass>
  <button type="button" class="pill" data-ns-isle-toggle aria-controls="isle-panel">
    <span class="ico" data-ns-isle-icon aria-hidden="true"><Icon d={SECTIONS[0].icon} size={17} /></span>
    <span class="txt"><b data-ns-isle-label>{SECTIONS[0].name}</b><small data-ns-isle-pos>1 de {SECTIONS.length} · desliza</small></span>
    <span class="chev" aria-hidden="true"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 9l4-4 4 4" /></svg></span>
  </button>
</nav>
<div class="panel" id="isle-panel" role="dialog" aria-modal="true" aria-label="Secciones" data-ns-isle-panel data-ns="all squircle 30; top cut center 22% 7 r3" data-ns-glass>
  <header data-ns-isle-handle><i class="handle" aria-hidden="true"></i><b>ns-frame</b><button type="button" data-ns-isle-close aria-label="Cerrar"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 3l8 8M11 3l-8 8" /></svg></button></header>
  <ul>
    {SECTIONS.map((s, i) => (
      <li><a href={`#${s.id}`} data-ns={i == 0 ? CUR : 'all squircle 16'} class:list={[{ 'ns-u': i == 0 }]}><Icon d={s.icon} /><span>{s.name}</span></a></li>
    ))}
  </ul>
  <div class="acts"><a href={LINKS.install}>Empezar</a><a href={LINKS.github}>GitHub</a></div>
</div>

<script>
  import { isle } from 'ns-frame/isle'
  import { jump } from '../../scripts/jump'
  const CUR = 'tl+br bevel 14; tr+bl round 16; radius 2', TILE = 'all squircle 16'
  // sólo en pantallas donde la isla se ve (en escritorio manda la barra superior)
  const mq = matchMedia('(max-width: 900px)')
  let nav: ReturnType<typeof isle> | null = null
  const init = () => {
    if (!mq.matches) { nav?.destroy(); nav = null; return }
    // el vidrio llega en un momento libre (hasta entonces, la cápsula y la hoja tienen su fondo opaco)
    ;(globalThis.requestIdleCallback || setTimeout)(() => import('ns-frame/glass'), { timeout: 1500 })
    nav ||= isle(document.getElementById('isle')!, {
      pos: (i, n) => `${i + 1} de ${n} · desliza`,
      go: t => jump(t, { smooth: true, focus: true }),
      // la sección actual cambia de forma en la hoja
      onChange: (i, a) => a.closest('ul')!.querySelectorAll('a').forEach((x, j) => {
        x.classList.toggle('ns-u', j == i)
        x.setAttribute('data-ns', j == i ? CUR : TILE)
      }),
      onOpen: () => navigator.vibrate?.(6),
    })
  }
  mq.addEventListener('change', init)
  init()
</script>

<style>
  .isle, .panel { display: none }
  @media (max-width: 900px) {
    :global(body) { padding-bottom: calc(84px + env(safe-area-inset-bottom)) }
    :global(.ns-isle-scrim) { --ns-isle-scrim: var(--veil-2) }

    /* cápsula: redondeo simple (vía rápida nativa); plegarla sólo cambia su ancho */
    /* de vidrio líquido (ns-frame/glass): tinte oscuro propio, así el texto blanco se lee sobre
       cualquier sección y el vidrio se oscurece un poco más sobre lo claro en vez de invertirse */
    .isle { display: block; position: fixed; z-index: 40; left: 50%; bottom: calc(14px + env(safe-area-inset-bottom)); width: 212px; height: 54px; translate: -50% 0;
      --ns-glass-tint: rgba(16, 16, 20, .42); color: var(--ns-glass-ink, var(--text)); contain: layout style; view-transition-name: ns-isle }
    /* mientras el vidrio no está activo (antes de cargar, o sin JS), un fondo opaco */
    .isle:not(:global(.ns-glass)), .panel:not(:global(.ns-glass)) { background: rgba(18, 18, 20, .97); --ns-border: rgba(255, 255, 255, .14) }
    .isle:global(.ns-mini) { width: 54px }
    .pill { position: absolute; inset: 0; display: flex; align-items: center; gap: 11px; padding: 0 8px 0 9px; border: 0; background: none; cursor: pointer; text-align: left }
    .ico { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex: none; background: var(--text); color: #0a0a0a }
    .ico :global(svg) { width: 17px; height: 17px }
    .txt { flex: 1; min-width: 0; overflow: hidden; display: grid; transition: opacity .2s, visibility .2s }
    .txt b { font: 700 var(--t-control)/1.15 var(--display); font-stretch: 106%; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
    .txt small { font: var(--t-micro)/1.3 var(--mono); color: var(--text-2); white-space: nowrap }
    .chev { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, .1); flex: none; transition: opacity .2s, visibility .2s }
    .chev svg { width: 14px; height: 14px }
    .isle:global(.ns-mini) .txt, .isle:global(.ns-mini) .chev { opacity: 0; visibility: hidden }

    /* hoja: posición y animación las pone ns-frame/isle; aquí sólo el aspecto */
    /* la hoja, también de vidrio: más desenfoque y más tinte (tiene la página entera detrás) */
    .panel { display: flex; flex-direction: column; gap: 14px; padding: 18px 16px 16px; --ns-glass-tint: rgba(16, 16, 20, .58); --ns-glass-blur: 16px; color: var(--ns-glass-ink, var(--text)); contain: layout style }
    header { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 14px 6px 0; cursor: grab }
    .handle { position: absolute; top: 0; left: 50%; width: 36px; height: 4px; margin-left: -18px; border-radius: var(--r-2xs); background: rgba(255, 255, 255, .22) }
    header b { font: 700 var(--t-title-lg)/1 var(--display); font-stretch: 108%; letter-spacing: -.02em }
    header button { width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .1); display: grid; place-items: center; cursor: pointer }
    header svg { width: 14px; height: 14px }
    ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none }
    ul a { display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 12px; min-height: 78px; background: rgba(255, 255, 255, .06); --ns-border: rgba(255, 255, 255, .06); --ns-morph-time: 320; transition: background-color .2s }
    ul a :global(svg) { color: var(--text-2); width: 22px; height: 22px }
    ul a span { font-size: var(--t-small); font-weight: 500; line-height: 1.2 }
    ul a[aria-current] { background: rgba(255, 255, 255, .1); --ns-u-bg: rgba(255, 255, 255, .1); --ns-u: #00e676; --ns-u-glow: .45; --ns-border: rgba(0, 230, 118, .45) }
    ul a[aria-current] :global(svg) { color: var(--signal) }
    .acts { display: flex; gap: 8px }
    .acts a { flex: 1; min-height: 48px; border-radius: 980px; display: grid; place-items: center; font-size: var(--t-control); font-weight: 500; background: rgba(255, 255, 255, .1) }
    .acts a:first-child { background: var(--text); color: var(--graphite) }
  }
</style>
