---
// Isla (móvil): el componente ns-frame/isle tal cual. Todo el aspecto y el comportamiento vienen de
// la librería (cápsula, hoja, transformación, arrastre, hueco al pie de la página); aquí sólo el
// marcado, las fuentes de la marca y el acento de la sección actual (chaflán y luz en U).
import Icon from '../Icon.astro'
import { SECTIONS, LINKS } from '../../data/sections'
const CUR = 'tl+br bevel 14; tr+bl round 16; radius 2'
---
<nav class="isle" id="isle" aria-label="Secciones" data-ns-isle data-ns-glass>
  <button type="button" data-ns-isle-toggle aria-controls="isle-panel">
    <span data-ns-isle-icon aria-hidden="true"><Icon d={SECTIONS[0].icon} size={17} /></span>
    <span data-ns-isle-text><b data-ns-isle-label>{SECTIONS[0].name}</b><small data-ns-isle-pos>1 de {SECTIONS.length} · desliza</small></span>
    <span data-ns-isle-more aria-hidden="true"></span>
  </button>
</nav>
<div class="panel" id="isle-panel" role="dialog" aria-modal="true" aria-label="Secciones" data-ns-isle-panel>
  <header data-ns-isle-handle><b>ns-frame</b><button type="button" data-ns-isle-close aria-label="Cerrar"></button></header>
  <ul data-ns-isle-links>
    {SECTIONS.map((s, i) => (
      <li><a href={`#${s.id}`} data-ns={i == 0 ? CUR : 'all squircle 16'} class:list={[{ 'ns-u': i == 0 }]}><Icon d={s.icon} /><span>{s.name}</span></a></li>
    ))}
  </ul>
  <div data-ns-isle-actions><a href={LINKS.install}>Empezar</a><a href={LINKS.github}>GitHub</a></div>
</div>

<script>
  import { isle } from 'ns-frame/isle'
  import { jump } from '../../scripts/jump'
  const CUR = 'tl+br bevel 14; tr+bl round 16; radius 2', TILE = 'all squircle 16'
  // sólo en pantallas donde la isla se ve (en escritorio manda la barra superior)
  const mq = matchMedia('(max-width: 900px)')
  let nav: ReturnType<typeof isle> | null = null
  const init = () => {
    if (!mq.matches) { nav?.destroy(); nav = null; return }
    // el vidrio de la cápsula llega en un momento libre (hasta entonces, su fondo opaco de serie)
    ;(globalThis.requestIdleCallback || setTimeout)(() => import('ns-frame/glass'), { timeout: 1500 })
    nav ||= isle(document.getElementById('isle')!, {
      pos: (i, n) => `${i + 1} de ${n} · desliza`,
      go: t => jump(t, { smooth: true, focus: true }),
      // la sección actual cambia de forma en la hoja
      onChange: (i, a) => a.closest('ul')!.querySelectorAll('a').forEach((x, j) => {
        x.classList.toggle('ns-u', j == i)
        x.setAttribute('data-ns', j == i ? CUR : TILE)
      }),
      onOpen: () => navigator.vibrate?.(6),
    })
  }
  mq.addEventListener('change', init)
  init()
</script>

<style>
  .isle, .panel { display: none }
  @media (max-width: 900px) {
    .isle { display: block }
    .panel { display: flex }
    :global(.ns-isle-scrim) { --ns-isle-scrim: var(--veil-2) }
    /* las fuentes de la marca */
    .isle :global([data-ns-isle-label]) { font: 700 var(--t-control)/1.15 var(--display); font-stretch: 106% }
    .isle :global([data-ns-isle-pos]) { font: var(--t-micro)/1.3 var(--mono) }
    .panel header b { font: 700 var(--t-title-lg)/1 var(--display); font-stretch: 108% }
    /* la sección actual: chaflán y luz en U, en el color de la marca */
    .panel [aria-current] { --ns-u-bg: rgba(255, 255, 255, .1); --ns-u: #00e676; --ns-u-glow: .45; --ns-border: rgba(0, 230, 118, .45) }
    .panel [aria-current] :global(svg) { color: var(--signal) }
    .panel ul a { --ns-border: rgba(255, 255, 255, .06); --ns-morph-time: 320 }
  }
</style>
