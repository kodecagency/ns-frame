---
// Ficha técnica como bento unificado (ns-frame/bento) sobre un fondo aura (ns-fx.css): las
// esquinas exteriores del conjunto llevan el corte grande y las interiores un radio discreto,
// así la rejilla se lee como una sola pieza. Sólo datos medidos (docs/rendimiento.md).
import Arrow from '../Arrow.astro'

const SIZES: [string, number][] = [['núcleo', 8.9], ['mosaico', 7.4], ['lite', 6.7], ['extras', 3.8], ['líquido', 2.5], ['skeleton', 2.4], ['concéntricas', 2.4], ['toast', 2.1]]
const max = 8.9 // el núcleo es el módulo más grande
---
<section class="sec aura ns-aura" id="cifras" aria-labelledby="t-cifras">
  <div class="wrap">
    <div class="head center">
      <h2 id="t-cifras">Pequeña, rápida y segura.</h2>
      <p class="lede">Un bento con <code>ns-frame/bento</code>: el corte grande sólo en las esquinas del conjunto, así toda la rejilla se lee como <b>una sola pieza esculpida</b>. Debajo, un fondo <code>ns-aura</code>.</p>
    </div>

    <div class="ns-bento bn" data-ns-bento="outer bevel 30; inner round 12; radius 2">
      <article class="ns-big t" data-ns-motion="spot">
        <span class="k">Núcleo, con gzip</span>
        <b class="v num">8,9 KB</b>
        <p>Formas, bordes, morph y foco. Cada módulo se carga sólo si se usa.</p>
        <ul class="bars" aria-label="Tamaño de cada módulo en KB">
          {SIZES.map(([n, v], k) => <li><span>{n}</span><svg viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><rect width={(v / max * 100).toFixed(1)} height="6" rx="3" class:list={[{ hi: k < 3 }]} /></svg><b class="num">{v.toFixed(1).replace('.', ',')}</b></li>)}
        </ul>
      </article>
      <article class="t" data-ns-motion="spot"><h3>Sin dependencias</h3><p>Ni una petición de red en tiempo de ejecución: todo lo dibuja el propio navegador.</p></article>
      <article class="t" data-ns-motion="spot"><h3>4.000 marcos, menos de 50 ms</h3><p>La tarea más larga al montarlos todos a la vez.</p></article>
      <article class="ns-w2 t" data-ns-motion="spot"><h3>Segura con una CSP estricta</h3><p>Sin <code>innerHTML</code> ni <code>unsafe-inline</code>: se prueba en cada versión con atributos maliciosos.</p></article>
      <article class="t" data-ns-motion="spot"><h3>Accesible de serie</h3><p>Foco con forma, alto contraste, movimiento reducido y RTL.</p></article>
      <article class="ns-w2 t" data-ns-motion="spot"><h3>Con cualquier framework</h3><p>Es un atributo HTML: HTML plano, Astro, React, Vue o Svelte. También compila a CSS <code>shape()</code> sin JS.</p></article>
      <article class="t" data-ns-motion="spot"><h3>Software libre</h3><p>Licencia MIT, de Kodec Agency.</p></article>
    </div>
    <p class="after center"><a class="more" href="/docs/rendimiento">Cómo se midió<Arrow /></a></p>
  </div>
</section>

<script>
  import 'ns-frame/bento'
</script>

<style>
  .aura { --ns-aura-1: #00e676; --ns-aura-2: #ffb547; --ns-aura-o: .42; padding-bottom: clamp(96px, 12vw, 160px) }
  code { font: var(--t-small) var(--mono); color: var(--text) }
  .center { text-align: center }
  .bn { --ns-gap: 12px; --ns-row: 150px; --ns-min: 220px; --ns-motion: rgba(255, 255, 255, .85); --ns-spot-size: 180; --ns-spot-fill: .06 }
  .t { background: rgba(20, 20, 22, .9); --ns-border: rgba(255, 255, 255, .12); display: flex; flex-direction: column; gap: 6px; min-width: 0 }
  .k { font-size: var(--t-small); color: var(--text-3) }
  .v { font: 700 clamp(26px, 2.6vw, 34px)/1.05 var(--display); font-stretch: 108%; letter-spacing: -.025em }
  .v.sm { font-size: var(--t-heading-fluid) }
  .t p { margin: 0; color: var(--text-2); font-size: var(--t-small) }
  .t h3 { font-size: var(--t-title-fluid); font-stretch: 106%; letter-spacing: -.015em }
  .ns-big .v { font-size: var(--t-number) }
  .bars { list-style: none; margin: auto 0 0; padding: 12px 0 0; display: grid; gap: 7px }
  .bars li { display: grid; grid-template-columns: 76px 1fr 34px; gap: 10px; align-items: center; font: var(--t-label) var(--mono); color: var(--text-3) }
  .bars svg { width: 100%; height: 6px; overflow: visible }
  .bars rect { fill: #8b8b94 }
  .bars rect.hi { fill: #00e676 }
  .bars b { text-align: right; font-weight: 500; color: var(--text-2) }
  @media (max-width: 560px) { .t p { font-size: var(--t-caption) } .bars li { grid-template-columns: 64px 1fr 30px } }
</style>
