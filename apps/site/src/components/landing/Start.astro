---
// Cierre: el snippet para copiar y los dos caminos siguientes, sobre una luz en U.
import SectionHead from '../SectionHead.astro'
import { LINKS } from '../../data/sections'
import Arrow from '../Arrow.astro'
const CDN = 'https://cdn.jsdelivr.net/gh/kodecagency/ns-frame@v0.10.0/packages/ns-frame/dist/ns-frame.js'
---
<section class="sec start" id="empezar" aria-labelledby="t-start">
  <div class="wrap">
    <div class="box ns-u" data-ns="tl bevel 40; br bevel 40; tr+bl round 24; top cut center 30% 8 r4; radius 4">
      <SectionHead id="t-start" center>
        <Fragment slot="title">Empieza en un minuto.</Fragment>
        Un script y un atributo. Funciona con HTML plano, Astro, React, Vue o Svelte.
      </SectionHead>
      <div class="install" data-ns="all round 14"><code id="snip">&lt;<b>script</b> type="module" src="{CDN}"&gt;&lt;/<b>script</b>&gt;</code><button type="button" id="copy" class="btn" data-ns="all round 10">Copiar</button></div>
      <div class="cta"><a class="btn go" href={LINKS.docs} data-ns="all round 50%">Leer la documentación</a><a class="more" href={LINKS.github}>Ver el código en GitHub<Arrow /></a></div>
    </div>
  </div>
</section>

<script>
  const copy = document.getElementById('copy')!
  copy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(document.getElementById('snip')!.textContent!); copy.textContent = 'Copiado' } catch { copy.textContent = 'No se pudo copiar' }
    setTimeout(() => (copy.textContent = 'Copiar'), 1600)
  })
</script>

<style>
  .box { padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 64px); text-align: center; --ns-u: #00e676; --ns-u-glow: .6; --ns-u-bg: var(--surface); --ns-border: linear-gradient(180deg, rgba(255, 255, 255, .06), rgba(0, 230, 118, .55)) }
  .box :global(.head) { margin-bottom: 28px }
  .install { display: flex; align-items: center; gap: 12px; max-width: 760px; margin: 0 auto; padding: 10px 10px 10px 18px; background: rgba(10, 10, 12, .8); --ns-border: var(--line-2); text-align: left }
  code { flex: 1; min-width: 0; font: var(--t-small)/1.5 var(--mono); color: var(--text-2); overflow-x: auto; white-space: nowrap }
  code b { color: var(--text); font-weight: 500 }
  .install .btn { flex: none; font-size: var(--t-ui); min-height: 44px; padding: 0 16px }
  .cta { justify-content: center }
</style>
