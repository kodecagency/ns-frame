---
// Componentes en uso, todos funcionando: popover con la flecha dentro de la forma, botones con
// estado presionado, un diálogo que se despliega respetando los cortes, avisos, carga sin saltos
// y un carrusel.
import SectionHead from '../SectionHead.astro'
import Arrow from '../Arrow.astro'

const SLIDES = [
  ['ns-c1', 'Sendero de montaña', 'Pico Espejo', '9 km · difícil'],
  ['ns-c2', 'Lago entre montañas', 'Laguna Negra', '6 km · media'],
  ['ns-c3', 'Costa rocosa', 'Playa Medina', '3 km · fácil'],
  ['ns-c4', 'Bosque nublado', 'Bosque de Niebla', '7 km · media'],
]
const MODES = ['open', 'split', 'iris', 'wipe', 'drop']
---
<section class="sec" id="componentes" aria-labelledby="t-comp">
  <div class="wrap">
    <SectionHead id="t-comp">
      <Fragment slot="title">Componentes listos, con su forma.</Fragment>
      Usan lo que el navegador ya sabe hacer: popover, <code>&lt;dialog&gt;</code>, la capa superior y el desplazamiento nativo. <b>El foco, el teclado y los lectores de pantalla funcionan como siempre.</b>
    </SectionHead>

    <div class="grid">
      <article class="c pop" data-ns="card">
        <h3>Popover con flecha</h3>
        <p>La flecha es parte del contorno y apunta al botón aunque el navegador lo voltee.</p>
        <div class="acts">
          <button type="button" class="btn ghost" data-ns="button" popovertarget="pop1">Abrir</button>
          <button type="button" class="btn ghost" data-ns="button" data-ns-tip="tip1">Ayuda</button>
        </div>
        <div popover id="pop1" data-ns-arrow="tl+br bevel 10; radius 2" class="pp"><b>Popover nativo</b><br>Esc o un clic fuera lo cierran.</div>
        <div popover="manual" id="tip1" data-ns-arrow="all round 8" role="tooltip" class="pp">Tooltip con puntero y con teclado.</div>
      </article>

      <article class="c press" data-ns="card">
        <h3>Estado presionado</h3>
        <p>La forma responde al puntero, al dedo y a Enter o Espacio.</p>
        <div class="acts">
          <button type="button" class="btn go" data-ns="tl+br bevel 12; radius 2" data-ns-hover="tl+br bevel 18; radius 2" data-ns-press="all bevel 5; radius 2">Presióname</button>
          <button type="button" class="btn ghost" data-ns="all round 50%" data-ns-press="all round 8">Píldora</button>
        </div>
      </article>

      <article class="c dlg-c" data-ns="tl bevel 26; br bevel 26; top cut center 30% 6; radius 3">
        <h3>Diálogos que se despliegan</h3>
        <p>Abren y cierran respetando los cortes: el borde acompaña y el contenido se revela recortado.</p>
        <div class="seg" id="dlg-modes" role="group" aria-label="Apertura">{MODES.map((m, i) => <button type="button" data-mode={m} aria-pressed={String(!i)}>{m}</button>)}</div>
        <div class="acts"><button type="button" class="btn" data-ns="button" id="dlg-open">Abrir diálogo</button></div>
      </article>

      <article class="c toast" data-ns="all round 20; top cut center 34% 8 r3">
        <h3>Avisos</h3>
        <p>El tiempo restante se consume en el borde y se pausa al pasar el puntero.</p>
        <div class="acts"><button type="button" class="btn ghost" data-ns="all round 12" data-toast="ok">Guardar cambios</button><button type="button" class="btn ghost" data-ns="all round 12" data-toast="error">Simular un error</button></div>
      </article>

      <article class="c skel" data-ns="soft">
        <h3>Carga sin saltos</h3>
        <p>El esqueleto se mide sobre el componente real, con sus cortes.</p>
        <div class="sk" id="sk" data-ns="all squircle 18" data-ns-skeleton><img src="https://picsum.photos/seed/ns-sk/128/128" alt="" width="56" height="56" data-ns="all squircle 16" loading="lazy"><div><b>Informe semanal</b><span>Latencia media: 84 ms</span></div></div>
        <div class="acts"><button type="button" class="btn ghost" data-ns="all round 12" id="sk-run">Volver a cargar</button></div>
      </article>

      <article class="c car-c" data-ns="all squircle 30">
        <h3>Carrusel</h3>
        <p>Desliza con el gesto del sistema; flechas e indicadores funcionan con teclado.</p>
        <div class="car" data-ns-carousel aria-label="Rutas destacadas">
          {SLIDES.map(([seed, alt, t, s]) => (
            <article class="slide" data-ns="media"><img src={`https://picsum.photos/seed/${seed}/480/360`} alt={alt} width="480" height="360" loading="lazy"><div><b>{t}</b><span>{s}</span></div></article>
          ))}
        </div>
      </article>
    </div>
    <p class="after"><a class="more" href="/docs/componentes">Todos los componentes<Arrow /></a></p>
  </div>

  <dialog id="dlg" aria-labelledby="dlg-t">
    <div class="dlg ns-grid ns-u" id="dlg-panel" data-ns="tl bevel 26; br bevel 26; top cut center 30% 7; radius 3" data-ns-motion="scan">
      <h3 id="dlg-t">Panel desplegado</h3>
      <p>Un <code>&lt;dialog&gt;</code> nativo: foco atrapado y <kbd>Esc</kbd> para cerrar. ns-frame sólo añade la apertura con <code>open(el, modo)</code> y el cierre con <code>close(el, modo)</code>.</p>
      <button type="button" class="btn" data-ns="button" id="dlg-close">Cerrar</button>
    </div>
  </dialog>
</section>

<script>
  import 'ns-frame/skel'
  import 'ns-frame/carousel'
  import 'ns-frame/pop'
  import { open, close } from 'ns-frame'
  import { toast } from 'ns-frame/toast'

  const MSG: Record<string, () => void> = {
    ok: () => toast('Los cambios del informe quedaron guardados.', { type: 'ok', title: 'Guardado' }),
    error: () => toast('No se pudo enviar el formulario.', {
      type: 'error', title: 'Sin conexión', time: 0,
      action: { label: 'Reintentar', onClick: () => toast('El formulario se envió.', { type: 'ok', title: 'Enviado' }) },
    }),
  }
  document.querySelectorAll<HTMLElement>('[data-toast]').forEach(b => b.addEventListener('click', () => MSG[b.dataset.toast!]()))

  // carga simulada: el esqueleto aparece con la forma real y se va sin mover nada
  const sk = document.getElementById('sk')!
  let t = 0
  const load = () => { clearTimeout(t); sk.setAttribute('data-ns-skeleton', ''); t = setTimeout(() => sk.removeAttribute('data-ns-skeleton'), 1800) }
  document.getElementById('sk-run')!.addEventListener('click', load)
  const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); load() } }, { threshold: .5 })
  io.observe(sk)

  // diálogo con apertura que respeta la forma
  const dlg = document.getElementById('dlg') as HTMLDialogElement, panel = document.getElementById('dlg-panel')!, modes = document.getElementById('dlg-modes')!
  let mode = 'open'
  modes.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLElement>('[data-mode]')
    if (!b) return
    mode = b.dataset.mode!
    modes.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x == b)))
  })
  document.getElementById('dlg-open')!.addEventListener('click', () => { dlg.showModal(); open(panel, mode) })
  const shut = () => Promise.resolve(close(panel, mode)).finally(() => dlg.close())
  document.getElementById('dlg-close')!.addEventListener('click', shut)
  dlg.addEventListener('cancel', e => { e.preventDefault(); shut() })
</script>

<style>
  code, kbd { font: 12.5px var(--mono); color: var(--text) }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: 'pop press dlg' 'car car toast' 'car car skel'; gap: 14px }
  .pop { grid-area: pop } .press { grid-area: press } .dlg-c { grid-area: dlg } .toast { grid-area: toast } .skel { grid-area: skel } .car-c { grid-area: car }
  .c { background: var(--surface); --ns-border: var(--line-2); padding: 22px; display: flex; flex-direction: column; gap: 8px; min-width: 0 }
  .c h3 { font-size: 17px }
  .c > p { margin: 0; color: var(--text-2); font-size: 14px }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 14px }
  .acts .btn { font-size: 14px; min-height: 42px; padding: 0 16px }
  .pop { background: radial-gradient(80% 70% at 100% 0%, rgba(255, 255, 255, .06), transparent 60%), var(--surface) }
  .press { background: radial-gradient(80% 70% at 0% 100%, rgba(0, 230, 118, .1), transparent 60%), var(--surface) }
  .dlg-c { --ns-border: rgba(212, 212, 216, .3) }
  .dlg-c .seg { align-self: flex-start; margin-top: 6px }
  .dlg-c .seg button { font-family: var(--mono); font-size: 12px; padding: 0 10px }
  .toast { background: radial-gradient(80% 70% at 100% 100%, rgba(255, 181, 71, .08), transparent 60%), var(--surface) }
  .car-c { --ns-car: #f4f4f5; --ns-car-bg: #1b1b1e; --ns-car-dot: rgba(255, 255, 255, .25) }
  .pp { --ns-border: rgba(255, 255, 255, .25); --ns-pop-bg: #1b1b1e; color: var(--text); font-size: 14px; max-width: 240px }
  .sk { margin-top: 8px; display: flex; gap: 14px; align-items: center; background: var(--surface-2); --ns-border: var(--line); padding: 12px }
  .sk img { width: 56px; height: 56px; object-fit: cover; flex: none }
  .sk b { display: block; font-size: 15px }
  .sk span, .slide span { font-size: 13px; color: var(--text-2) }
  .car { --ns-slide: calc((100% - 24px) / 3); margin-top: 10px }
  .slide { background: var(--surface-2); --ns-border: var(--line); display: flex; flex-direction: column }
  .slide img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover }
  .slide div { padding: 12px 16px 16px }
  .slide b { display: block; font: 600 16px/1.2 var(--display); font-stretch: 106% }
  dialog { border: 0; padding: 0; background: transparent; color: var(--text); max-width: min(480px, calc(100% - 32px)) }
  dialog::backdrop { background: rgba(5, 5, 6, .7); backdrop-filter: blur(6px) }
  .dlg { padding: 32px 30px 28px; display: grid; gap: 12px; background: var(--surface-2); --ns-u-bg: var(--surface-2); --ns-u: #00e676; --ns-u-glow: .45; --ns-border: rgba(0, 230, 118, .5); --ns-inner: 6px; --ns-motion: #fff; --ns-pat: rgba(255, 255, 255, .05); --ns-pat-mask: linear-gradient(#000, transparent 70%) }
  .dlg h3 { font-size: 22px }
  .dlg p { margin: 0; color: var(--text-2); font-size: 15px }
  .dlg .btn { justify-self: start }
  :global(.ns-toasts) { font-family: var(--body) }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: 'pop press' 'dlg toast' 'car car' 'skel skel' } .car { --ns-slide: 46% } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; grid-template-areas: 'pop' 'press' 'dlg' 'toast' 'skel' 'car' } .car { --ns-slide: 78% } .c { padding: 20px 18px } }
</style>
