---
// Mosaico interactivo: plantilla, forma del hueco, contenido del orbe y luz conectada.
import SectionHead from '../SectionHead.astro'
import Arrow from '../Arrow.astro'

const TEMPLATES = [['t-orb', 'Orbe'], ['t-duo', 'Dúo'], ['t-lock', 'Encaje'], ['t-step', 'Escalera']]
// forma del hueco · radio en escritorio · radio en móvil (el radio es la apotema) · icono
const HOLES = [
  ['circle 96 62', 'Círculo', 'M10 3.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13Z'],
  ['hex 86 56', 'Hexágono', 'M10 3 16 6.5v7L10 17l-6-3.5v-7Z'],
  ['diamond 78 50', 'Rombo', 'M10 2.5 17.5 10 10 17.5 2.5 10Z'],
  ['tri 56 38', 'Triángulo', 'M10 3.5 17 16H3Z'],
]
const FILLS = [['', 'Sólido'], ['is-photo', 'Foto'], ['is-data', 'Dato']]
// material de las piezas: sólido o vidrio líquido (ns-frame/glass sobre la forma de cada pieza)
const MATS = [['', 'Sólido'], ['glass', 'Vidrio']]
// un efecto a la vez en la demo (la librería los combina: data-ns-mosaic="stream dots")
const FX = [['', 'Ninguno'], ['stream', 'Corriente'], ['trace', 'Trazo'], ['wave', 'Onda'], ['sweep', 'Barrido'], ['pulse', 'Pulso'], ['aurora', 'Aurora'], ['dots', 'Puntos'], ['grid', 'Retícula'], ['glow', 'Luz'], ['ripple', 'Toque']] as const
const START = 'stream'
// color de la luz (--ns-mosaic-light)
const TINTS = [['#ffffff', 'Blanco'], ['#00e676', 'Verde'], ['#3de0ff', 'Cian'], ['#ffb547', 'Ámbar']]
// los grupos, también como selectores nativos para el móvil (los mismos valores; cada uno pulsa su botón)
const PICKS = [
  ['mo-modes', 'Plantilla', TEMPLATES.map(([v, n]) => [v, n])],
  ['mo-hole', 'Hueco', HOLES.map(([v, n]) => [v, n])],
  ['mo-fill', 'Orbe', FILLS.map(([v, n]) => [v, n])],
  ['mo-mat', 'Material', MATS.map(([v, n]) => [v, n])],
  ['mo-fx', 'Efecto', FX.map(([v, n]) => [v, n])],
] as const
---
<section class="sec dark2" id="mosaico" aria-labelledby="t-mo">
  <div class="wrap">
    <SectionHead id="t-mo">
      <Fragment slot="title">Piezas que encajan.</Fragment>
      Un bento donde cada pieza puede ser una L, una T o una escalera. Las curvas guardan el mismo hueco que las rectas, y un orbe recorta a sus vecinas. <b>En el móvil sigue siendo un mosaico, no una lista.</b>
    </SectionHead>

    <!-- barra: en el escritorio, fija mientras el mosaico está en pantalla (sin subir y bajar para
         probar otra opción); en el móvil, selectores nativos en dos columnas, sin desplazamiento lateral -->
    <div class="bar" role="group" aria-label="Opciones del mosaico">
      <div class="seg" id="mo-modes" role="group" data-ns-choice aria-label="Plantilla">{TEMPLATES.map(([t, n], i) => <button type="button" data-v={t} aria-pressed={String(!i)}>{n}</button>)}</div>
      <div class="seg" id="mo-hole" role="group" data-ns-choice aria-label="Forma del hueco">{HOLES.map(([h, n, d], i) => <button type="button" class="ico" data-v={h} aria-pressed={String(!i)} aria-label={n} title={n}><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg></button>)}</div>
      <div class="seg" id="mo-fill" role="group" data-ns-choice aria-label="Contenido del orbe">{FILLS.map(([c, n]) => <button type="button" data-v={c} aria-pressed={String(c == 'is-photo')}>{n}</button>)}</div>
      <div class="seg" id="mo-mat" role="group" data-ns-choice aria-label="Material de las piezas">{MATS.map(([c, n], i) => <button type="button" data-v={c} aria-pressed={String(!i)}>{n}</button>)}</div>
      <div class="fx" id="mo-fx" role="group" aria-label="Efecto de luz" data-ns-choice>
        {FX.map(([k, n]) => <button type="button" data-v={k} aria-pressed={String(k == START)}>{n}</button>)}
      </div>
      <div class="picks">
        {PICKS.map(([id, n, opts]) => (
          <label><span>{n}</span><select data-for={id}>{opts.map(([v, t]) => <option value={v} selected={id == 'mo-fx' ? v == START : id == 'mo-fill' ? v == 'is-photo' : v == opts[0][0]}>{t}</option>)}</select></label>
        ))}
      </div>
      <div class="knobs">
        <label><span>Velocidad <output id="mo-speed-v">1×</output></span><input type="range" id="mo-speed" min="0.4" max="2.5" step="0.1" value="1"></label>
        <label><span>Intensidad <output id="mo-int-v">7 %</output></span><input type="range" id="mo-int" min="0" max="0.3" step="0.01" value="0.07"></label>
        <div class="tints" id="mo-tint" role="group" data-ns-choice aria-label="Color de la luz">{TINTS.map(([c, n], i) => <button type="button" data-v={c} aria-pressed={String(!i)} aria-label={n} title={n}></button>)}</div>
      </div>
    </div>

    <div class="mo-stage" id="mo-stage">
    <div class="mo ns-mosaic t-orb" id="mo" data-ns-mosaic={START}>
      <article data-ns-area="h" class="hi"><h3>Formas que se abrazan.</h3><p>La plantilla vive en CSS: cámbiala con una media query y las piezas se reacomodan.</p></article>
      <article data-ns-area="a" class="ph"><img src="https://picsum.photos/seed/ns-mosaic-a/700/800.webp" alt="Fachada de edificios antiguos" width="700" height="800" loading="lazy"><h3>Fotos con forma</h3><p>La imagen se recorta con la pieza.</p></article>
      <article data-ns-area="b"><h3>Pesa 7,4 KB</h3><p>Un módulo opcional, con gzip.</p></article>
      <article data-ns-area="c"><h3>Hueco constante</h3><p>La esquina cóncava mide el radio más el hueco.</p></article>
      <article data-ns-area="d"><h3>Dos columnas en el móvil</h3><p>Sigue siendo un mosaico.</p></article>
      <article data-ns-area="x"><h3>Orbes con forma</h3><p><code>--ns-orb: 3 3 96 hex</code></p></article>
      <article data-ns-area="y"><h3>Texto que fluye</h3><p>En una L, una escalera o junto al orbe, el texto recorre toda la figura con el mismo margen.</p></article>
      <article data-ns-area="e"><h3>Sólo HTML y CSS</h3><p>Sin framework.</p></article>
      <article data-ns-area="f"><p>El orden del DOM no cambia: se lee igual con lector de pantalla.</p></article>
      <div data-ns-orb class="orb is-photo" id="mo-orb"><img src="https://picsum.photos/seed/ns-orb-city/400/400.webp" alt="Ciudad de noche" width="400" height="400" loading="lazy"><div class="ok"><b class="num">99,9 %</b><small>disponibilidad</small></div></div>
      <div data-ns-orb class="orb orb-2" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 5 13h6l-1 8 8-10h-6Z" /></svg></div>
    </div>
    </div>
    <p class="after"><a class="more" href="/docs/mosaico">Cómo funciona el mosaico<Arrow /></a></p>
  </div>
</section>

<script>
  import { refresh, arrange } from 'ns-frame/mosaic'

  const $ = (id: string) => document.getElementById(id)!
  const mo = $('mo'), modes = $('mo-modes'), hole = $('mo-hole'), fill = $('mo-fill'), fx = $('mo-fx'), orb = $('mo-orb')
  // los grupos son grupos de elección de ns-frame (data-ns-choice): cambian aria-pressed solos y
  // avisan con change; aquí sólo se decide qué hace cada opción
  const picked = (e: Event) => (e as CustomEvent<{ button: HTMLElement }>).detail.button

  // plantilla: con View Transitions las piezas viajan a su nuevo sitio (arrange de ns-frame/mosaic)
  const TEMPLATES = ['t-orb', 't-duo', 't-lock', 't-step']
  const template = (t: string) => arrange(mo, () => { mo.classList.remove(...TEMPLATES); mo.classList.add(t) })
  modes.addEventListener('change', e => template(picked(e).dataset.v!))

  hole.addEventListener('change', e => {
    const [k, r, rm] = picked(e).dataset.v!.split(' ')
    Object.entries({ '--hole': k, '--hole-r': r, '--hole-rm': rm }).forEach(([p, v]) => mo.style.setProperty(p, v))
    mo.classList.contains('t-orb') ? refresh() : modes.querySelector<HTMLElement>('[data-v=t-orb]')!.click()
  })

  // contenido del orbe; si sólo es decoración, se oculta a los lectores de pantalla
  fill.addEventListener('change', e => {
    const c = picked(e).dataset.v
    orb.classList.remove('is-photo', 'is-data')
    if (c) { orb.classList.add(c); orb.removeAttribute('aria-hidden') } else orb.setAttribute('aria-hidden', 'true')
  })

  // material: vidrio líquido en cada pieza (salvo la foto), con la forma que le da el mosaico. El
  // módulo del vidrio se pide la primera vez; el mosaico pasa a estar sobre una foto
  $('mo-mat').addEventListener('change', e => {
    const glass = picked(e).dataset.v == 'glass'
    if (glass) import('ns-frame/glass')
    $('mo-stage').classList.toggle('glassy', glass)
    mo.querySelectorAll<HTMLElement>(':scope > [data-ns-area]:not(.ph)').forEach(a => glass ? a.setAttribute('data-ns-glass', '') : a.removeAttribute('data-ns-glass'))
  })

  // un efecto a la vez; velocidad, intensidad y color son variables de la librería:
  // --ns-mosaic-fx-time (la duración de cada efecto), --ns-mosaic-speed (la corriente, px/s),
  // --ns-mosaic-fill (sobre los fondos) y --ns-mosaic-light
  const BASE: Record<string, number> = { wave: 4.5, sweep: 5, scan: 4.5, pulse: 3.6, trace: 6, aurora: 5 }
  let effect = mo.getAttribute('data-ns-mosaic') || ''
  const speed = $('mo-speed') as HTMLInputElement, int = $('mo-int') as HTMLInputElement
  const tune = () => {
    const k = +speed.value
    $('mo-speed-v').textContent = k.toFixed(1).replace('.0', '').replace('.', ',') + '×'
    $('mo-int-v').textContent = Math.round(+int.value * 100) + ' %'
    effect in BASE ? mo.style.setProperty('--ns-mosaic-fx-time', (BASE[effect] / k).toFixed(2) + 's') : mo.style.removeProperty('--ns-mosaic-fx-time')
    mo.style.setProperty('--ns-mosaic-speed', String(Math.round(160 * k)))
    mo.style.setProperty('--ns-mosaic-fill', int.value)
  }
  fx.addEventListener('change', e => { effect = picked(e).dataset.v || ''; mo.setAttribute('data-ns-mosaic', effect); tune() })
  // (la corriente es JS: su velocidad se relee al soltar el control; lo demás es CSS y cambia al momento)
  speed.addEventListener('input', tune); int.addEventListener('input', tune)
  speed.addEventListener('change', () => refresh())
  $('mo-tint').addEventListener('change', e => mo.style.setProperty('--ns-mosaic-light', picked(e).dataset.v!))
  // (el color de cada muestra por CSSOM: la CSP estricta del sitio no deja estilos en línea en el HTML)
  $('mo-tint').querySelectorAll<HTMLElement>('button').forEach(b => b.style.setProperty('--c', b.dataset.v!))
  tune()

  // en táctil no hay puntero que flote: la luz que lo sigue y la onda al tocar no existen (la librería
  // las quita), así que tampoco se ofrecen
  if (matchMedia('(hover: none) and (pointer: coarse)').matches)
    document.querySelectorAll('#mo-fx [data-v=glow], #mo-fx [data-v=ripple], .picks option[value=glow], .picks option[value=ripple]').forEach(n => n.remove())

  // móvil: cada selector pulsa el botón de su grupo (mismo estado, mismo evento change)
  document.querySelectorAll<HTMLSelectElement>('.picks select').forEach(s => {
    const g = $(s.dataset.for!)
    s.addEventListener('change', () => [...g.querySelectorAll<HTMLElement>('button')].find(b => (b.dataset.v || '') == s.value)?.click())
    // (y al revés: un cambio desde los botones —o desde el código— se refleja en el selector)
    g.addEventListener('change', e => { s.value = picked(e).dataset.v || '' })
  })
</script>

<style>
  .bar { position: sticky; top: 56px; z-index: 5; display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; margin: 0 0 16px; padding: 8px; border-radius: 18px; border: 1px solid var(--line); background: #0e0e10; view-transition-name: mo-bar }
  .bar .seg button { min-height: 36px; padding: 0 12px }
  .seg .ico { width: 40px; padding: 0 !important; display: grid; place-items: center }
  .seg .ico svg { width: 18px; height: 18px }
  /* dos filas: plantilla, hueco, orbe y los ajustes; debajo, los efectos */
  .fx { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; order: 2; flex-basis: 100% }
  .fx button { min-height: 36px; padding: 0 12px; border-radius: 980px; border: 1px solid var(--line); background: transparent; color: var(--text-2); font-size: var(--t-small); cursor: pointer; transition: color .2s, border-color .2s, background-color .2s }
  .fx button:hover { color: var(--text); border-color: var(--line-2) }
  .fx button[aria-pressed=true] { color: var(--text); border-color: rgba(0, 230, 118, .55); background: rgba(0, 230, 118, .08) }
  .picks { display: none }
  .knobs { display: flex; gap: 8px 16px; align-items: center; order: 1; flex: 1 1 380px; padding: 0 4px }
  .knobs label { display: grid; gap: 2px; min-width: 110px; flex: 1 1 130px; max-width: 200px; font-size: var(--t-caption); color: var(--text-2) }
  .knobs label span { display: flex; justify-content: space-between }
  .knobs output { font: var(--t-caption) var(--mono); color: var(--text) }
  .knobs input { width: 100%; height: 24px; margin: 0; accent-color: var(--signal) }
  .tints { display: flex; gap: 8px; margin-left: auto }
  .tints button { width: 28px; height: 28px; border-radius: 50%; border: 2px solid transparent; background: var(--c) padding-box; box-shadow: 0 0 0 1px var(--line-2); cursor: pointer }
  .tints button[aria-pressed=true] { border-color: #0e0e10; box-shadow: 0 0 0 2px var(--text) }

  .mo { --ns-gap: 14px; --ns-row: 150px; --ns-mosaic-radius: 26px; --ns-pad: 24px; --ns-mosaic-light: #fff }
  /* material vidrio: el mosaico sobre una foto y las piezas de vidrio líquido (sin fondo propio; el
     texto toma el color que contrasta con lo de detrás, --ns-glass-ink) */
  .mo-stage { position: relative; border-radius: 30px; transition: padding .35s var(--ease) }
  .mo-stage.glassy { padding: 18px; background: #0b0b0d url(https://picsum.photos/seed/ns-mosaic-glass/1400/1000.webp) center / cover }
  .glassy .mo > [data-ns-area]:not(.ph) { background: none !important; color: var(--ns-glass-ink, #fff) }
  .glassy .mo p, .glassy .mo .hi h3, .glassy .mo .hi p { color: color-mix(in srgb, var(--ns-glass-ink, #fff) 88%, transparent) }
  .glassy .mo .hi h3 { color: var(--ns-glass-ink, #fff) }
  .mo > [data-ns-area] { background: #18181a; --ns-border: rgba(255, 255, 255, .08); min-width: 0 }
  /* rectángulos: columna; piezas con forma (.ns-flow): el texto recorre toda la figura */
  .mo > [data-ns-area]:not(:global(.ns-flow)) { display: flex; flex-direction: column; gap: 6px }
  .mo > :global(.ns-flow) > :not(:global(.ns-fl), :global(.ns-fr)) + * { margin-top: 8px }
  .mo p { margin: 0; color: var(--text-2); font-size: var(--t-control) }
  .mo h3 { font-size: var(--t-title-lg) }
  .hi { background: #f5f5f5 !important; --ns-border: none !important; text-align: center; align-items: center }
  .hi h3 { color: #0a0a0a; font-size: var(--t-h2); line-height: 1; letter-spacing: -.035em; font-stretch: 110% }
  .mo .hi p { color: var(--ink-2); text-wrap: balance }
  .ph { background: #0a0a0a !important }
  .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover }
  .ph::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--veil-2), rgba(0, 0, 0, .05) 50%, var(--veil-2)) }
  .ph > :not(img) { position: relative; z-index: 1 }
  .mo .ph p { color: var(--silver) }
  .ph h3, .ph p { text-shadow: 0 1px 12px var(--veil-3) }
  code { font: var(--t-small) var(--mono); color: var(--signal) }
  .big { font: 700 clamp(26px, 2.6vw, 34px)/1 var(--display); font-stretch: 108%; letter-spacing: -.035em }

  .orb { display: grid; place-items: center; overflow: hidden; color: #0a0a0a; text-align: center; background: #1c1c1f; --ns-border: rgba(255, 255, 255, .22); --ns-inner: 8px; --ns-inner-color: rgba(0, 230, 118, .4) }
  .orb[hidden] { display: none }
  .orb > img, .orb > .ok { grid-area: 1 / 1; opacity: 0; transition: opacity .45s }
  .orb > img { width: 100%; height: 100%; object-fit: cover }
  .ok b { display: block; font: 700 clamp(22px, 2.6vw, 32px)/1 var(--display); letter-spacing: -.03em }
  .ok small { font-size: var(--t-caption); color: var(--ash) }
  .orb.is-photo > img, .orb.is-data > .ok { opacity: 1 }
  .orb.is-data { background: #0a0a0a; color: var(--text); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .14) }
  .orb.is-data .ok b { color: var(--signal) }
  .orb-2 { background: var(--signal) !important; color: #0a0a0a }
  .orb-2 svg { width: 42%; height: 42% }

  /* plantillas: --ns-areas cambia con la clase y con el ancho */
  .t-orb { --ns-areas: 'a h h b' 'a h h c' 'd x y c' 'e x y f'; --ns-orb: 3 3 var(--hole-r, 96) var(--hole, circle) }
  .t-duo { --ns-areas: 'h h a b' 'h h c b' 'x y c d' 'x y e f'; --ns-orb: 3 3 70 hex, 2 4 44 circle }
  .t-lock { --ns-areas: 'h h h b' 'a x x b' 'a a x c' 'd y e f'; --ns-orb: none }
  .t-step { --ns-areas: 'h h a a' 'x h h a' 'x b h c' 'd y e f'; --ns-orb: none }
  @media (max-width: 900px) {
    /* selectores nativos en dos columnas (nada que desplazar de lado) y los ajustes debajo; la barra
       no es fija: en el móvil taparía media pantalla */
    .bar { position: static; display: grid; gap: 10px; padding: 12px }
    .bar > .seg, .bar > .fx { display: none }
    .picks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px }
    .mo-stage.glassy { padding: 10px; border-radius: 24px }
    .picks label { display: grid; gap: 4px; font-size: var(--t-caption); color: var(--text-2) }
    .picks select { width: 100%; min-height: 44px; padding: 0 12px; border-radius: 12px; border: 1px solid var(--line-2); background: #18181a; color: var(--text); font: inherit; font-size: var(--t-small) }
    .knobs { flex-wrap: wrap; padding: 8px 0 0; border-top: 1px solid var(--line) }
    .knobs label { max-width: none }
    .tints { margin-left: 0 }
    .mo { --ns-row: 112px; --ns-gap: 10px; --ns-mosaic-radius: 20px; --ns-pad: 16px }
    .t-orb { --ns-areas: 'h h' 'h h' 'x y' 'x y' 'a b' 'a c' 'd c' 'e f'; --ns-orb: 2 3 var(--hole-rm, 62) var(--hole, circle) }
    .t-duo { --ns-areas: 'h h' 'h h' 'x y' 'x y' 'a b' 'c b' 'c e' 'd e' 'f f'; --ns-orb: 2 3 50 hex, 2 7 34 circle }
    .t-lock { --ns-areas: 'h h' 'h b' 'a b' 'a a' 'x a' 'x x' 'c y' 'd y' 'e f' }
    .t-step { --ns-areas: 'h h' 'x h' 'x a' 'b a' 'c y' 'd e' 'f f' }
    .mo p { font-size: var(--t-small) }
    .mo h3 { font-size: var(--t-body) }
    .mo .hi h3 { font-size: var(--t-heading) }
    .big { font-size: var(--t-heading) }
  }
</style>
