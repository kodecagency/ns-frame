---
// Movimiento: todas las animaciones de borde a la vez, cada una sobre una forma distinta.
// Luces cortas con halo (--ns-glow), nunca líneas largas y planas. Se pausan fuera de pantalla
// y se apagan con prefers-reduced-motion.
import SectionHead from '../SectionHead.astro'
import Arrow from '../Arrow.astro'

const M = [
  { m: 'comet', s: 'card', c: 'white', t: 'Cometa', d: 'Luz corta con estela' },
  { m: 'twin', s: 'soft', c: 'green', t: 'Dos luces', d: 'Carga o espera' },
  { m: 'orbit', s: 'all squircle 36', c: 'amber', t: 'Órbita', d: 'Destellos alrededor' },
  { m: 'scan', s: 'wing', c: 'white', t: 'Barrido', d: 'Cruza el marco' },
  { m: 'chase', s: 'hud', c: 'lime', t: 'Persecución', d: 'Pulsos de datos' },
  { m: 'pulse', s: 'ticket', c: 'green', t: 'Pulso', d: 'El borde respira' },
  { m: 'loop', s: 'plate', c: 'silver', t: 'Trazo', d: 'Se dibuja y se borra' },
  { m: 'march', s: 'notch', c: 'amber', t: 'Marcha', d: 'Zona para soltar' },
  { m: 'glitch', s: 'tl+br bevel 18; top cut 60% 85% 5; radius 2', c: 'coral', t: 'Interferencia', d: 'Error o alerta' },
  { m: 'spot', s: 'all round 20', c: 'white', t: 'Foco', d: 'Sigue al puntero' },
  { m: 'twin hover', s: 'card', hover: 'tl+br bevel 30; radius 3', c: 'white', t: 'Al pasar', d: 'Sólo con el puntero' },
]
---
<section class="sec" id="movimiento" aria-labelledby="t-mov">
  <div class="wrap">
    <SectionHead id="t-mov">
      <Fragment slot="title">Luz que recorre el borde.</Fragment>
      Un atributo, <code>data-ns-motion</code>. Recorre el contorno exacto de cualquier forma, se combina (<code>"scan march"</code>), se colorea con <code>--ns-motion</code> y <b>se pausa fuera de pantalla o si el sistema pide menos movimiento.</b>
    </SectionHead>

    <div class="grid">
      {M.map(x => (
        <article class:list={['mv', 'c-' + x.c]} data-ns={x.s} data-ns-hover={x.hover} data-ns-motion={x.m}>
          <b>{x.t}</b><span>{x.d}</span><code class="tag">"{x.m}"</code>
        </article>
      ))}
      <article class="mv prog c-green" id="mv-prog" data-ns="tl+br bevel 18; radius 3" data-ns-motion="progress">
        <b><span id="mv-val" class="num">64</span> %</b>
        <label class="range"><span>Progreso en el borde</span><input type="range" min="0" max="100" value="64" id="mv-input"></label>
        <code class="tag">"progress"</code>
      </article>
    </div>
    <p class="after"><a class="more" href="/docs/movimiento">Todas las opciones de movimiento<Arrow /></a></p>
  </div>
</section>

<script>
  const input = document.getElementById('mv-input') as HTMLInputElement, box = document.getElementById('mv-prog')!
  input.addEventListener('input', () => { box.style.setProperty('--ns-progress', input.value); document.getElementById('mv-val')!.textContent = input.value })
</script>

<style>
  code { font: var(--t-small) var(--mono); color: var(--text) }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px }
  .mv { min-height: 150px; padding: 20px; display: flex; flex-direction: column; gap: 4px; min-width: 0;
    background: radial-gradient(90% 70% at 50% 120%, color-mix(in srgb, var(--c) 10%, transparent), transparent 70%), var(--surface);
    --ns-border: rgba(255, 255, 255, .1); --ns-accent-width: 1.5px; --ns-glow: drop-shadow(0 0 5px var(--c)); --ns-spot-size: 140; --ns-spot-fill: .08; --ns-morph-time: 360 }
  .c-white { --c: #ffffff } .c-green { --c: #00e676 } .c-amber { --c: #ffb547 } .c-lime { --c: #b8f36b } .c-silver { --c: #d4d4d8 } .c-coral { --c: #ff7a59 }
  .mv { --ns-motion: var(--c) }
  .prog { --ns-progress: 64 }
  .mv b { font: 600 var(--t-title)/1.2 var(--display); font-stretch: 106% }
  .mv span { font-size: var(--t-small); color: var(--text-2) }
  .mv .tag { margin-top: auto; padding-top: 12px }
  .range { display: grid; gap: 6px; font-size: var(--t-small); color: var(--text-2) }
  .range input { width: 100%; accent-color: var(--signal); height: 24px; margin: 0 }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)) } }
  @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px } .mv { min-height: 128px; padding: 20px 18px } .mv b { font-size: var(--t-control) } .mv span { font-size: var(--t-caption) } }
</style>
