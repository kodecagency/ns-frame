---
// Movimiento: un solo escenario con forma; se elige qué luz recorre su borde.
// La luz es blanca, corta y con halo (--ns-glow), sobre una pista tenue: el borde apagado también se ve.
import SectionHead from '../SectionHead.astro'
import Arrow from '../Arrow.astro'
import { LINKS } from '../../data/sections'

const MOTIONS = [
  { m: 'comet', name: 'Cometa', text: 'Una luz corta con estela da la vuelta al contorno exacto de la forma.' },
  { m: 'twin', name: 'Dos luces', text: 'Dos destellos opuestos, para estados de carga o de espera.' },
  { m: 'spot', name: 'Foco', text: 'La luz sigue al puntero por el borde y aclara un poco el interior.' },
  { m: 'pulse', name: 'Pulso', text: 'El contorno entero respira despacio: un aviso que no molesta.' },
  { m: 'progress', name: 'Progreso', text: 'El borde es la barra. Arrastra el control para moverla.' },
]
---
<section class="sec" id="movimiento" aria-labelledby="t-mov">
  <div class="wrap">
    <SectionHead id="t-mov">
      <Fragment slot="title">Luz que sigue el borde.</Fragment>
      Una animación de borde es un atributo más. Recorre el contorno exacto, se pausa fuera de pantalla y <b>se apaga si el sistema pide menos movimiento.</b>
    </SectionHead>

    <div class="seg" id="mv-pick" role="group" aria-label="Animación del borde">
      {MOTIONS.map((x, i) => <button type="button" data-m={x.m} data-text={x.text} aria-pressed={String(!i)}>{x.name}</button>)}
    </div>
    <div class="stage" id="mv-stage" data-ns="all squircle 40" data-ns-motion={MOTIONS[0].m} style="--ns-progress:64">
      <div class="copy">
        <h3 id="mv-name">{MOTIONS[0].name}</h3>
        <p id="mv-text" aria-live="polite">{MOTIONS[0].text}</p>
        <code><span>data-ns-motion=</span>"<b id="mv-code">{MOTIONS[0].m}</b>"</code>
        <label class="range" id="mv-range" hidden><span>Progreso <b id="mv-val" class="num">64</b> %</span><input type="range" min="0" max="100" value="64" id="mv-input"></label>
      </div>
    </div>
    <p class="after"><a class="more" href={`${LINKS.gallery}#movimiento`}>Las 11 animaciones, en la galería<Arrow /></a></p>
  </div>
</section>

<script>
  const $ = (id: string) => document.getElementById(id)!
  const pick = $('mv-pick'), stage = $('mv-stage'), range = $('mv-range'), input = $('mv-input') as HTMLInputElement
  pick.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLElement>('button[data-m]')
    if (!b) return
    pick.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x == b)))
    stage.setAttribute('data-ns-motion', b.dataset.m!)
    $('mv-name').textContent = b.textContent
    $('mv-text').textContent = b.dataset.text!
    $('mv-code').textContent = b.dataset.m!
    range.hidden = b.dataset.m != 'progress'
  })
  input.addEventListener('input', () => { stage.style.setProperty('--ns-progress', input.value); $('mv-val').textContent = input.value })
</script>

<style>
  .seg { display: inline-flex; flex-wrap: wrap; padding: 4px; gap: 2px; border-radius: 28px; background: var(--surface); border: 1px solid var(--line); margin-top: 64px }
  .seg button { min-height: 40px; padding: 0 16px; border: 0; border-radius: 980px; background: transparent; color: var(--text-2); font-size: 14px; cursor: pointer; transition: background-color .25s var(--ease), color .2s }
  .seg button:hover { color: var(--text) }
  .seg button[aria-pressed=true] { background: var(--text); color: #0a0a0a }
  .stage { margin-top: 20px; min-height: clamp(320px, 42vw, 460px); display: flex; align-items: flex-end; padding: clamp(28px, 4vw, 56px); background: #121212;
    --ns-border: rgba(255, 255, 255, .1); --ns-motion: #fff; --ns-accent-width: 1.5px; --ns-glow: drop-shadow(0 0 6px rgba(255, 255, 255, .55)); --ns-spot-size: 280; --ns-spot-fill: .05; --ns-motion-time: 5s }
  .copy { max-width: 520px; display: grid; gap: 12px }
  h3 { font-size: clamp(30px, 4vw, 48px); line-height: 1; font-weight: 700; font-stretch: 110%; letter-spacing: -.035em }
  p { margin: 0; color: var(--text-2); font-size: 17px; max-width: 42ch }
  code { font: 14px var(--mono); color: var(--text-2) }
  code b { color: var(--signal); font-weight: 400 }
  .range { display: grid; gap: 10px; margin-top: 8px; font-size: 14px; color: var(--text-2) }
  .range[hidden] { display: none }
  .range b { color: var(--text); font-weight: 500 }
  input { width: min(360px, 100%); accent-color: var(--signal); height: 24px }
</style>
