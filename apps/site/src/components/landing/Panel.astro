---
// Panel de vidrio: muchas piezas de vidrio a la vez (bloques, botones redondos, niveles) en UNA pasada,
// con data-ns-glass-group="pane". Todo es de la librería: el vidrio (ns-frame/glass), los grupos de
// botones que se activan (data-ns-choice del núcleo) y los niveles verticales (ns-frame/controls).
// La página sólo decide la composición y los iconos.
import SectionHead from '../SectionHead.astro'
import Arrow from '../Arrow.astro'

// iconos: Lucide 1.48.0 (https://lucide.dev), licencia ISC · Copyright (c) Lucide Contributors.
// Trazo en una rejilla de 24 (el grosor lo pone el CSS); los de reproducción van rellenos
const I = {
  plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  cast: '<path d="M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"/><path d="M2 12a9 9 0 0 1 8 8"/><path d="M2 16a5 5 0 0 1 4 4"/><path d="M2 20h.01"/>',
  wifi: '<path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/>',
  bars: '<path d="M2 20h.01"/><path d="M7 20v-4"/><path d="M12 20v-8"/><path d="M17 20V8"/><path d="M22 4v16"/>',
  lock: '<circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/>',
  bell: '<path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M17 17H4a1 1 0 0 1-.74-1.673C4.59 13.956 6 12.499 6 8a6 6 0 0 1 .258-1.742"/><path d="m2 2 20 20"/><path d="M8.668 3.01A6 6 0 0 1 18 8c0 2.687.77 4.653 1.707 6.05"/>',
  moon: '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  sound: '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/>',
  torch: '<path d="M12 13v1"/><path d="M17 2a1 1 0 0 1 1 1v4a3 3 0 0 1-.6 1.8l-.6.8A4 4 0 0 0 16 12v8a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2v-8a4 4 0 0 0-.8-2.4l-.6-.8A3 3 0 0 1 6 7V3a1 1 0 0 1 1-1z"/><path d="M6 6h12"/>',
  timer: '<path d="M10 2h4"/><path d="m12 14 3-3"/><circle cx="12" cy="14" r="8"/>',
  calc: '<rect width="16" height="20" x="4" y="2" rx="2"/><path d="M8 6h8"/><path d="M16 14v4"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  camera: '<path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"/><circle cx="12" cy="13" r="3"/>',
  prev: '<path d="M17.971 4.285A2 2 0 0 1 21 6v12a2 2 0 0 1-3.029 1.715l-9.997-5.998a2 2 0 0 1-.003-3.432z"/><path d="M3 20V4"/>',
  play: '<path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/>',
  next: '<path d="M21 4v16"/><path d="M6.029 4.285A2 2 0 0 0 3 6v12a2 2 0 0 0 3.029 1.715l9.997-5.998a2 2 0 0 0 .003-3.432z"/>',
  bed: '<path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"/><path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><path d="M12 4v6"/><path d="M2 18h20"/>',
  sparkles: '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>',
  user: '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  idcard: '<path d="M13 19a4 4 0 0 0-8 0"/><path d="M16 10h2"/><path d="M16 14h2"/><circle cx="9" cy="12" r="3"/><rect x="2" y="5" width="20" height="14" rx="2"/>',
  dots: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
  updown: '<path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/>',
  back: '<path d="m15 18-6-6 6-6"/>',
}
type K = keyof typeof I
// modos de enfoque: clave · nombre · descripción · icono · color (--m: el círculo del icono al activarse)
const MODES: [string, string, string, K, string][] = [
  ['dnd', 'No molestar', 'Silencia todos los avisos', 'moon', '#5e5ce6'],
  ['sleep', 'Sueño', 'Pausa los avisos al dormir', 'bed', '#30b0c7'],
  ['less', 'Menos interrupciones', 'Sólo lo importante', 'sparkles', '#bf5af2'],
  ['me', 'Personal', 'Desconecta de la jornada', 'user', '#ff9f0a'],
  ['work', 'Trabajo', 'Pon manos a la obra', 'idcard', '#34c759'],
]
// bloque de conexiones: icono · nombre · encendido al empezar · color al encenderse (--ns-pane-on)
const NET: [K, string, boolean, string][] = [['plane', 'Modo avión', false, '#ff9f0a'], ['cast', 'Compartir cerca', false, '#34c759'], ['wifi', 'Wi-Fi', true, '#2f7cf6'], ['bars', 'Datos', true, '#34c759']]
const QUICK: [K, string][] = [['lock', 'Bloquear giro'], ['bell', 'Silencio']]
const ROW: [K, string][] = [['torch', 'Linterna'], ['timer', 'Temporizador'], ['calc', 'Calculadora'], ['camera', 'Cámara']]
---
<section class="sec dark" id="panel" aria-labelledby="t-pn">
  <div class="wrap pn-wrap">
    <div class="pn-text">
      <SectionHead id="t-pn">
        <Fragment slot="title">Mucho vidrio, una pasada.</Fragment>
        Bloques, botones redondos y niveles: cada pieza es vidrio con su forma, y todas se dibujan juntas. El coste no crece con el número de piezas, así que el móvil aguanta un panel entero.
      </SectionHead>
      <pre class="pn-code" data-ns-code="scroll"><code>&lt;div data-ns-glass-group="pane"&gt;
  &lt;div data-ns-glass&gt;…&lt;/div&gt;
  &lt;button data-ns-glass&gt;…&lt;/button&gt;
  &lt;label data-ns-level data-ns-glass&gt;
    &lt;input type="range"&gt;
  &lt;/label&gt;
&lt;/div&gt;</code></pre>
      <p class="pn-note">Sobre una foto o un vídeo, un solo lienzo WebGL dibuja lente, desenfoque y canto de todas las piezas, igual en todos los navegadores. Sobre la página, una lente de la unión en Chromium y un desenfoque compartido en los demás. Todo se ajusta con variables.</p>
      <p class="after"><a class="more" href="/docs/componentes">Cómo funciona el grupo de vidrio<Arrow /></a></p>
    </div>

    <div class="pn-stage" data-ns-glass-group="pane">
      <div class="pn">
        <div class="pn-net" data-ns-glass data-ns-choice="many" role="group" aria-label="Conexiones">
          {NET.map(([k, n, on, c]) => <button type="button" class="pn-b" data-ns-glass aria-pressed={String(on)} aria-label={n} title={n} data-on={c}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I[k]} /></button>)}
        </div>
        <div class="pn-media" data-ns-glass role="group" aria-label="Reproducción">
          <p><b>Sin reproducción</b><small>Nada en cola</small></p>
          <div class="pn-ctl">
            <button type="button" aria-label="Anterior"><svg class="f" viewBox="0 0 24 24" aria-hidden="true" set:html={I.prev} /></button>
            <span data-ns-choice="many"><button type="button" aria-pressed="false" aria-label="Reproducir"><svg class="f" viewBox="0 0 24 24" aria-hidden="true" set:html={I.play} /></button></span>
            <button type="button" aria-label="Siguiente"><svg class="f" viewBox="0 0 24 24" aria-hidden="true" set:html={I.next} /></button>
          </div>
        </div>
        <div class="pn-quick" data-ns-choice="many" role="group" aria-label="Ajustes rápidos">
          {QUICK.map(([k, n]) => <button type="button" class="pn-b" data-ns-glass aria-pressed="false" aria-label={n} title={n}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I[k]} /></button>)}
        </div>
        <!-- enfoque: el círculo activa el modo; el nombre con su flecha abre la lista para elegir otro -->
        <div class="pn-focus" data-ns-glass data-color={MODES[0][4]}>
          <span class="pn-fsw" data-ns-choice="many"><button type="button" class="pn-fon" aria-pressed="false" aria-labelledby="pn-fname"><span class="pn-dot" aria-hidden="true"><svg viewBox="0 0 24 24" id="pn-ficon" set:html={I[MODES[0][3]]} /></span></button></span>
          <button type="button" class="pn-fmore" id="pn-fmore" aria-expanded="false" aria-controls="pn-menu" aria-describedby="pn-fhint"><span class="pn-fname" id="pn-fname">{MODES[0][1]}</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.updown} /><span class="pn-sr" id="pn-fhint">Elegir modo de enfoque</span></button>
        </div>
        <label class="pn-lv" data-ns-level data-ns-glass><input type="range" aria-label="Brillo" min="0" max="100" value="62"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.sun} /></label>
        <label class="pn-lv" data-ns-level data-ns-glass><input type="range" aria-label="Volumen" min="0" max="100" value="38"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.sound} /></label>
        <div class="pn-row" data-ns-choice="many" role="group" aria-label="Accesos">
          {ROW.map(([k, n]) => <button type="button" class="pn-b" data-ns-glass aria-pressed="false" aria-label={n} title={n}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I[k]} /></button>)}
        </div>
      </div>
      <!-- tres vistas en el mismo sitio, como un panel de sistema: el panel, la lista de modos y las
           opciones de un modo. La que no se ve queda oculta con su tamaño (el grupo de vidrio sólo
           dibuja las piezas visibles). Un modo a la vez: data-ns-choice con role="radio" -->
      <div class="pn-view pn-menu" id="pn-menu" hidden>
        <div class="pn-mhead">
          <button type="button" class="pn-back" id="pn-back" data-ns-glass aria-label="Volver al panel"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.back} /></button>
          <b id="pn-mtitle">Enfoque</b>
        </div>
        <div class="pn-modes" role="radiogroup" aria-labelledby="pn-mtitle" data-ns-choice>
        {MODES.map(([k, n, s, ic, c], i) => (
          <div class="pn-mode" data-ns-glass data-color={c}>
            <button type="button" role="radio" aria-checked={String(!i)} class="pn-mpick" data-mode={k} data-name={n} data-color={c}>
              <svg class="pn-mi" viewBox="0 0 24 24" aria-hidden="true" set:html={I[ic]} />
              <span class="pn-mt"><b>{n}</b><small>{s}</small></span>
            </button>
            <button type="button" class="pn-mx" data-mode={k} data-name={n} aria-label={`Opciones de ${n}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.dots} /></button>
          </div>
        ))}
        </div>
      </div>
      <div class="pn-view pn-ov" id="pn-ov" hidden>
        <div class="pn-mhead">
          <button type="button" class="pn-back" id="pn-oback" data-ns-glass aria-label="Volver a los modos"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={I.back} /></button>
          <b id="pn-otitle">Opciones</b>
        </div>
        <div class="pn-orows" id="pn-orows">
          <label class="pn-orow" data-ns-glass><span>Permitir llamadas de favoritos</span><input type="checkbox" id="pn-o1" data-ns-switch checked></label>
          <label class="pn-orow" data-ns-glass><span>Mostrar en la pantalla bloqueada</span><input type="checkbox" id="pn-o2" data-ns-switch></label>
          <div class="pn-orow pn-odur" data-ns-glass><span id="pn-odur">Duración</span><div data-ns-segment="sm" data-ns-choice role="group" aria-labelledby="pn-odur" id="pn-oseg"><button type="button" aria-pressed="true">1 h</button><button type="button" aria-pressed="false">Tarde</button><button type="button" aria-pressed="false">Mañana</button></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // el vidrio y los niveles son módulos de la librería, pedidos al acercarse el panel (no en la carga
  // de la página). El color de cada conexión y de cada modo son variables (por CSSOM: CSP estricta)
  import { reduced } from 'ns-frame'
  import { near } from '../../scripts/near'
  const stage = document.querySelector<HTMLElement>('.pn-stage')!
  near(stage, () => import('ns-frame/glass'))
  document.querySelectorAll<HTMLElement>('.pn [data-on]').forEach(b => b.style.setProperty('--ns-pane-on', b.dataset.on!))
  document.querySelectorAll<HTMLElement>('.pn-stage [data-color]').forEach(b => b.style.setProperty('--m', b.dataset.color!))

  // ── tres vistas en el mismo sitio: panel → modos → opciones de un modo ──
  // Al cambiar, lo que se ve se encoge y se va (rápido, a la vez) y lo nuevo aparece pieza a pieza de
  // arriba abajo, creciendo desde un poco más pequeño, como en un panel de sistema. Las piezas son
  // vidrio: el grupo sigue su tamaño en cada fotograma. Con movimiento reducido, al instante
  const $ = (id: string) => document.getElementById(id)!
  const pn = stage.querySelector<HTMLElement>('.pn')!, menu = $('pn-menu'), ov = $('pn-ov')
  const more = $('pn-fmore'), pill = stage.querySelector<HTMLElement>('.pn-focus')!, on = stage.querySelector<HTMLElement>('.pn-fon')!
  type V = 'grid' | 'list' | 'opts'
  const VIEW = { grid: pn, list: menu, opts: ov }
  // las piezas de cada vista, en orden de lectura
  const pieces = (v: V) => [...VIEW[v].querySelectorAll<HTMLElement>(v == 'grid' ? '.pn-net, .pn-media, .pn-quick > *, .pn-focus, .pn-lv, .pn-row > *' : '.pn-back, .pn-mhead b, .pn-mode, .pn-orow')]
  const show = (v: V, yes: boolean) => v == 'grid' ? stage.classList.toggle('pn-open', !yes) : (VIEW[v].hidden = !yes)
  let cur: V = 'grid', busy = false
  // (la pieza se anima en tamaño y visibilidad —su vidrio la sigue—; la opacidad, en lo que lleva
  // dentro: el desenfoque del vidrio lo dibuja el grupo y no se desvanecería con la pieza)
  // (la visibilidad cambia en el primer 1 % de la entrada y en el último 1 % de la salida: WebKit la
  // cambia a mitad de camino si sólo hay dos fotogramas, y la pieza —y su vidrio— tardaban en verse)
  const anim = (e: HTMLElement, frames: Keyframe[], fade: [number, number], o: KeyframeAnimationOptions) => {
    const a = e.animate(frames, o)
    for (const c of e.children) (c as HTMLElement).animate([{ opacity: fade[0] }, { opacity: fade[1] }], o)
    return a.finished.catch(() => {})
  }
  const OUT: Keyframe[] = [{ transform: 'none', visibility: 'visible' }, { transform: 'scale(.9)', visibility: 'visible', offset: .99 }, { transform: 'scale(.9)', visibility: 'hidden' }]
  const IN: Keyframe[] = [{ transform: 'translateY(-8px) scale(.86)', visibility: 'hidden' }, { transform: 'translateY(-8px) scale(.86)', visibility: 'visible', offset: .01 }, { transform: 'none', visibility: 'visible' }]
  const go = async (to: V, focus?: HTMLElement | null) => {
    if (busy || to == cur) return
    busy = true
    const from = cur, calm = reduced()
    cur = to
    // salida: todas a la vez, 160 ms
    if (!calm) await Promise.all(pieces(from).map(e => anim(e, OUT, [1, 0],
      { duration: 160, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' })))
    show(from, false)
    for (const e of pieces(from)) { e.getAnimations().forEach(a => a.cancel()); for (const c of e.children) c.getAnimations().forEach(a => a.cancel()) }
    show(to, true)
    more.setAttribute('aria-expanded', String(to != 'grid'))
    // entrada: una tras otra (45 ms), 380 ms cada una, con un leve rebote al final
    const P = pieces(to)
    if (!calm) P.forEach((e, i) => anim(e, IN, [0, 1],
      { duration: 380, delay: i * 45, easing: 'cubic-bezier(.2,.9,.3,1.08)', fill: 'backwards' }))
    // (el foco, cuando su pieza ya se ve: un elemento oculto no se puede enfocar)
    const k = Math.max(0, P.findIndex(e => !!focus && e.contains(focus)))
    setTimeout(() => focus?.focus({ preventScroll: true }), calm ? 0 : k * 45 + 90)
    busy = false
  }

  // la pastilla de enfoque: el nombre abre la lista; elegir un modo lo pone en la pastilla y lo activa
  more.addEventListener('click', () => go('list', menu.querySelector<HTMLElement>('[aria-checked=true]')))
  $('pn-back').addEventListener('click', () => go('grid', more))
  menu.addEventListener('change', e => {
    const b = (e as CustomEvent<{ button: HTMLElement }>).detail.button
    pill.style.setProperty('--m', b.dataset.color!)
    $('pn-fname').textContent = b.dataset.name!
    $('pn-ficon').innerHTML = b.querySelector('.pn-mi')!.innerHTML
    on.setAttribute('aria-pressed', 'true')
    go('grid', more)
  })
  // (un toque en el modo ya elegido también vuelve; el «•••» abre sus opciones; el fondo, vuelve)
  menu.addEventListener('click', e => {
    const t = e.target as Element, b = t.closest('.pn-mpick'), o = t.closest<HTMLElement>('.pn-mx')
    if (o) { load(o.dataset.mode!, o.dataset.name!); go('opts', $('pn-oback')); return }
    if (b ? b.getAttribute('aria-checked') == 'true' : t == menu || t.classList.contains('pn-modes')) go('grid', more)
  })

  // las opciones de cada modo se guardan por modo: al abrirlas se cargan las suyas
  const o1 = $('pn-o1') as HTMLInputElement, o2 = $('pn-o2') as HTMLInputElement, seg = [...ov.querySelectorAll<HTMLElement>('#pn-oseg button')]
  const saved = new Map<string, { a: boolean, b: boolean, d: number }>()
  let optsFor = ''
  const load = (k: string, name: string) => {
    optsFor = k
    $('pn-otitle').textContent = name
    const s = saved.get(k) ?? { a: true, b: false, d: 0 }
    o1.checked = s.a; o2.checked = s.b
    seg.forEach((x, i) => x.setAttribute('aria-pressed', String(i == s.d)))
  }
  ov.addEventListener('change', () => optsFor && saved.set(optsFor, { a: o1.checked, b: o2.checked, d: Math.max(0, seg.findIndex(x => x.getAttribute('aria-pressed') == 'true')) }))
  const backToList = () => go('list', menu.querySelector<HTMLElement>(`.pn-mx[data-mode="${optsFor}"]`))
  $('pn-oback').addEventListener('click', backToList)
  ov.addEventListener('click', e => { if (e.target == ov || (e.target as Element).classList.contains('pn-orows')) backToList() })

  // Escape: de las opciones a la lista; de la lista al panel
  stage.addEventListener('keydown', e => {
    if (e.key != 'Escape' || cur == 'grid') return
    e.preventDefault()
    cur == 'opts' ? backToList() : go('grid', more)
  })
</script>

<style>
  .pn-wrap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center }
  /* el código: data-ns-code de ns-frame/controls */
  .pn-code { margin-top: 20px; border: 1px solid var(--line); --ns-code-bg: #0e0e10; --ns-code-ink: var(--text-2); --ns-code-pad: 16px 18px; --ns-code-radius: 16px }
  .pn-note { margin: 16px 0 0; color: var(--text-2); font-size: var(--t-control); max-width: 52ch }

  /* el escenario: una foto detrás (el grupo la detecta y usa el motor WebGL) */
  .pn-stage { --c: clamp(64px, 17vw, 78px); --g: clamp(12px, 3.4vw, 16px); padding: calc(var(--g) * 1.6); border-radius: 36px; overflow: hidden; background: #111 url(https://picsum.photos/seed/ns-panel-glass/900/1100.webp) center / cover; --ns-pane-on-ink: #0a0a0a }
  .pn { display: grid; grid-template-columns: repeat(4, var(--c)); grid-auto-rows: var(--c); gap: var(--g); color: #fff }
  .pn-stage svg { fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round }
  /* (rellenos: el trazo fino redondea las esquinas, como el glifo de sistema) */
  .pn-stage svg.f { fill: currentColor; stroke-width: 1.2 }
  .pn-stage button { font: inherit; cursor: pointer }
  .pn-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap }

  .pn-b { display: grid; place-items: center; padding: 0; border: 0; border-radius: 50% }
  .pn-b svg { width: 36%; height: 36% }
  .pn-b[aria-pressed=true] { color: var(--ns-pane-on-ink) }
  .pn-b[data-on][aria-pressed=true] { color: #fff }

