---
// Layout de las páginas de marketing: meta, fuentes, tokens y el núcleo de ns-frame.
import { Font } from 'astro:assets'
import 'ns-frame/fx.css'
import '../styles/tokens.css'
import Seo from '../components/Seo.astro'
import { LINKS, AUTHOR, AGENCY } from '../data/sections'
import pkg from 'ns-frame/package.json'

interface Props { title: string; description: string }
const { title, description } = Astro.props
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <Seo title={title} description={description} ld={[
    { '@type': 'WebSite', name: 'ns-frame', inLanguage: 'es', ...(Astro.site && { url: Astro.site.href }) },
    { '@type': 'SoftwareSourceCode', name: 'ns-frame', description, programmingLanguage: ['JavaScript', 'CSS'], runtimePlatform: 'Navegador web', license: 'https://www.apache.org/licenses/LICENSE-2.0', codeRepository: LINKS.github, version: pkg.version, keywords: pkg.keywords.join(', '), author: AUTHOR, publisher: AGENCY },
  ]} />
  <meta name="theme-color" content="#0a0a0a">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <Font cssVariable="--font-mona" preload />
  <Font cssVariable="--font-mono" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <slot />
  <script>
    // núcleo: activa todos los data-ns de la página (y los que se añadan después)
    import 'ns-frame'
    import 'ns-frame/fx'
    // controles de serie (segmentos, fichas, campos, deslizadores, muestras): aspecto de la librería
    import 'ns-frame/controls'
    import { wire } from '../scripts/jump'
    wire()
  </script>
</body>
</html>
