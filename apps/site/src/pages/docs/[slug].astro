---
import { getCollection, render } from 'astro:content'
import Docs from '../../layouts/Docs.astro'

export async function getStaticPaths() {
  // (las guías con demos vivas tienen su propia página, como controles.astro; getStaticPaths corre
  // aislada del resto del archivo: lo que usa va dentro)
  const own = new Set(['controles'])
  return (await getCollection('docs')).filter(entry => !own.has(entry.id)).map(entry => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---
<Docs title={entry.data.title} description={entry.data.description} slug={entry.id}>
  <Content />
</Docs>
