---
// Landing: cada sección es un componente; los datos compartidos viven en src/data.
import Site from '../layouts/Site.astro'
import TopBar from '../components/landing/TopBar.astro'
import Hero from '../components/landing/Hero.astro'
import Shapes from '../components/landing/Shapes.astro'
import Mosaic from '../components/landing/Mosaic.astro'
import Motion from '../components/landing/Motion.astro'
import Components from '../components/landing/Components.astro'
import Stats from '../components/landing/Stats.astro'
import Start from '../components/landing/Start.astro'
import Footer from '../components/landing/Footer.astro'
import Isle from '../components/landing/Isle.astro'
---
<Site title="ns-frame · Dale forma a cualquier elemento" description="ns-frame: chaflanes, muescas, squircles y mosaicos de piezas que encajan sobre cualquier elemento HTML. Bordes reales, animación y accesibilidad en 8 KB, sin imágenes.">
  <TopBar />
  <main id="contenido">
    <Hero />
    <Shapes />
    <Mosaic />
    <Motion />
    <Components />
    <Stats />
    <Start />
  </main>
  <Footer />
  <Isle />
</Site>
