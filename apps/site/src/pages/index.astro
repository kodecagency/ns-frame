---
// Landing: cada sección es un componente; los datos compartidos viven en src/data.
import Site from '../layouts/Site.astro'
import TopBar from '../components/landing/TopBar.astro'
import Hero from '../components/landing/Hero.astro'
import Why from '../components/landing/Why.astro'
import Shapes from '../components/landing/Shapes.astro'
import Playground from '../components/landing/Playground.astro'
import Borders from '../components/landing/Borders.astro'
import Mosaic from '../components/landing/Mosaic.astro'
import Beyond from '../components/landing/Beyond.astro'
import Motion from '../components/landing/Motion.astro'
import Components from '../components/landing/Components.astro'
import Views from '../components/landing/Views.astro'
import Anatomy from '../components/landing/Anatomy.astro'
import Stats from '../components/landing/Stats.astro'
import Start from '../components/landing/Start.astro'
import Footer from '../components/landing/Footer.astro'
import Isle from '../components/landing/Isle.astro'
---
<Site title="ns-frame · Dale forma a cualquier elemento" description="Chaflanes, muescas, squircles, bordes en degradado, vidrio y mosaicos que encajan en cualquier elemento HTML. 11 KB, accesible, sin imágenes ni dependencias.">
  <TopBar />
  <main id="contenido">
    <Hero />
    <Why />
    <Shapes />
    <Playground />
    <Borders />
    <Mosaic />
    <Beyond />
    <Motion />
    <Components />
    <Views />
    <Anatomy />
    <Stats />
    <Start />
  </main>
  <Footer />
  <Isle />
</Site>
